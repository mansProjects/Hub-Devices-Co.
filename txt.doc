body .contactUs{
    display: flex;
    flex-direction: column;
    margin: 10px 0;
  
}
body .contactUs .socialMedias p{
    font-size: 15px;
}
body .contactUs .socialMedias .iconsSocialMedias{
    font-size: 15px;
}
body .sectionContactUs .contactUs .contactForms form {
    display: flex;
    flex-direction: column;
}
body .sectionContactUs .contactUs .contactForms form  .nameAndfirstname{
    display: flex;
    flex-direction: column;
}
body .sectionContactUs .contactUs .contactForms form .telAndMessage{
     display: flex;
    flex-direction: column;
}
body .sectionContactUs .contactUs .contactForms form input{
    width: 90%;
    background: none;
    background-color: #ffffff;
    padding: 10px;
    border:none;
    border-radius: 4px;
    margin-bottom: 10px;
    box-shadow: inset 0px 0px 2px rgba(0,0,0,.2);
}
body .sectionContactUs .contactUs .contactForms form textarea{
    width: 90%;
}
body .sectionContactUs .contactUs .contactForms form input.envoyer{
    margin: 20px 0 0 0;
    width: 80%;
}